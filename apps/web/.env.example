# ══════════════════════════════════════════════════════════════════════════════
# InterviewKit Web Frontend — Environment Variables Template
# Copy this file to .env and configure your values.
# Never commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── API Client Configuration ──────────────────────────────────────────────────
# Client-side base URL for the InterviewKit API.
# Leave blank to use relative '/api' requests (handled by Vite proxy in dev or Netlify redirect in production).
# In production, you can set this directly to your deployed backend (e.g. https://interviewkit-api.onrender.com)
VITE_API_URL=

# ── Netlify Deployment / Proxy Target ──────────────────────────────────────────
# Deployed backend URL used by Netlify build scripts to dynamically configure API proxy redirects (/api/* -> ${BACKEND_URL}/api/:splat).
# Example: https://interviewkit-api.onrender.com
BACKEND_URL=
