# ══════════════════════════════════════════════════════════════════════════════
# InterviewKit — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── AI ────────────────────────────────────────────────────────────────────────
# Google Gemini API key
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
LLM_MAX_RETRIES=5

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/interviewkit

# ── Session ───────────────────────────────────────────────────────────────────
# A long, random string for signing session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Crawler settings ─────────────────────────────────────────────────────────
# Maximum time (ms) to wait for a single page fetch
CRAWL_TIMEOUT_MS=10000
# Maximum response body size in bytes
CRAWL_MAX_BYTES=500000
# Maximum pages to crawl per company URL
CRAWL_MAX_PAGES=10

# ── Coverage engine ───────────────────────────────────────────────────────────
# Maximum number of coverage-check + gap-fill passes
MAX_COVERAGE_PASSES=3

# ── LLM rate limiting ────────────────────────────────────────────────────────
# Maximum concurrent LLM requests
LLM_CONCURRENCY=2
